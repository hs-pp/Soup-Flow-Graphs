<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="GraphInspectorView.uss"/>
    <ui:VisualElement name="header-container" class="graphInspectorHeaderContainer">
        <ui:VisualElement class="graphInspectorTitleRow">
            <ui:Image name="ping-icon" tooltip="Ping the graph asset" class="graphInspectorPingIcon"/>
            <ui:Label text="Graph" name="title" class="graphInspectorHeaderTitle"/>
        </ui:VisualElement>
        <ui:Label text="Graph Type" name="type-label" class="graphInspectorHeaderTypeLabel"/>
    </ui:VisualElement>
    <ui:VisualElement name="subgraph-inspector-slot" style="flex-grow: 1;"/>
    <ui:Label text="Graph Properties" class="graphInspectorSectionCaption"/>
    <ui:VisualElement class="graphInspectorDivider"/>
    <ui:VisualElement name="properties-container" class="graphInspectorPropertiesContainer"/>
    <Soup.Editor.Views.Inspector.Blackboards.BlackboardView name="blackboard-view"/>
</ui:UXML>
