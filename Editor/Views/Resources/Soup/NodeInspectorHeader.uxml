<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Soup/Editor/Views/Resources/Soup/NodeInspectorView.uss?fileID=7433441132597879392&amp;guid=f508447914ca64fa49528e95403aae1e&amp;type=3#NodeInspectorView"/>
    <ui:VisualElement name="header-container" class="nodeInspectorHeaderContainer" style="flex-grow: 1;">
        <ui:VisualElement name="title-row" class="nodeInspectorHeaderTitleRow">
            <ui:Label text="Label" name="title" class="nodeInspectorHeaderTitle"/>
            <uie:ColorField name="color-swatch" tooltip="Node color" class="nodeInspectorColorSwatch"/>
        </ui:VisualElement>
        <ui:Label text="Label" name="id-label" class="nodeInspectorHeaderIdLabel" style="display: none;"/>
    </ui:VisualElement>
    <Soup.Editor.Views.Extraneous.SpeechBubbleElement name="comment-bubble" arrow-side="Top" class="nodeInspectorComment">
        <ui:TextField name="comment-field" multiline="true" placeholder-text="Add a comment" hide-placeholder-on-focus="true" class="nodeInspectorCommentField"/>
    </Soup.Editor.Views.Extraneous.SpeechBubbleElement>
</ui:UXML>
