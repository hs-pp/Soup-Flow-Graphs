/* The node search dropdown: a search field, a header with the page title and a back arrow, then the page's rows.
   Colors come from the editor theme, so the window follows the light and dark skins. */
.nodeSearchWindow {
    background-color: var(--unity-colors-window-background);
    border-width: 1px;
    border-color: var(--unity-colors-window-border);
}

.nodeSearchField {
    margin: 6px 6px 5px 6px;
}

.nodeSearchHeader {
    height: 24px;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--unity-colors-toolbar-border);
    background-color: var(--unity-colors-toolbar-background);
}

.nodeSearchTitle {
    -unity-font-style: bold;
}

.nodeSearchBackArrow {
    position: absolute;
    left: 6px;
    font-size: 16px;
}

.nodeSearchRows {
    flex-grow: 1;
}

.nodeSearchRow {
    height: 20px;
    flex-direction: row;
    align-items: center;
    padding: 0 8px 0 10px;
}

.nodeSearchRow Label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.nodeSearchRowHighlighted {
    background-color: var(--unity-colors-highlight-background);
}

.nodeSearchRowHighlighted Label {
    color: var(--unity-colors-highlight-text);
}

.nodeSearchRowName {
    flex-grow: 1;
    flex-shrink: 0;
}

.nodeSearchRowPath {
    flex-shrink: 1;
    margin-left: 8px;
    opacity: 0.5;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nodeSearchRowArrow {
    font-size: 14px;
}
