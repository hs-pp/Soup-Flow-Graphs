:root {
}

.nodeComment {
    position: absolute;
    bottom: 100%;
    left: 0;
    width: 280px;
    align-items: flex-start;
}

.commentContainer {
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 10px;
    margin-left: 2px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    max-width: 200px;
    border-color: rgba(0, 0, 0, 0);
    --bubble-fill-color: rgb(92, 95, 102);
    --bubble-border-color: rgb(112, 116, 124);
    --bubble-arrow-offset: 6;
    --bubble-arrow-width: 10;
    --bubble-arrow-height: 6;
}

.commentLabel {
    font-size: 10px;
    -unity-font-style: italic;
    white-space: normal;
    color: rgb(226, 228, 232);
    padding-top: 1px;
    padding-right: 1px;
    padding-bottom: 1px;
    padding-left: 1px;
}
