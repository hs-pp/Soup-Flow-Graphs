<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="InspectorView.uss"/>
    <ui:ScrollView name="scrollview">
        <ui:VisualElement name="root" class="root">
            <ui:VisualElement name="title-container" class="titleContainer" style="flex-grow: 1;">
                <ui:Label text="Inspector" name="title" class="title"/>
            </ui:VisualElement>
            <Soup.Editor.Views.Inspector.NodeInspectorView name="node-inspector-view"/>
            <Soup.Editor.Views.Inspector.MultiNodeInspectorView name="multi-node-inspector-view"/>
            <Soup.Editor.Views.Inspector.GroupInspectorView name="group-inspector-view"/>
            <Soup.Editor.Views.Inspector.GraphInspectorView name="graph-inspector-view"/>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
