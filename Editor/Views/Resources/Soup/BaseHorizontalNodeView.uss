.nodeTitle {
    flex-direction: row;
    justify-content: space-between;
    height: 28px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

.nodeTitleLabel {
    color: rgb(255, 255, 255);
    font-size: 12px;
    margin: 6px;
    padding-left: 2px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nodeIo {
    flex-direction: row;
    justify-content: space-between;
}

.nodeIoInput,
.nodeIoOutput {
    padding: 4px 0;
}

.nodeExtensionContainer {
    border-top-color: rgb(34, 34, 34);
    border-top-width: 1px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
}

.subGraphNodeIcon {
    width: 54px;
    height: 38px;
    align-self: center;
    background-image: url("SubGraphNodeIcon.png");
    -unity-background-image-tint-color: rgb(185, 189, 196);
}

.subGraphNodeName {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 4px;
    white-space: normal;
}

.nodeWarningLabel {
    color: rgb(240, 180, 60);
}
