<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="EntryNodeView.uss"/>
    <ui:VisualElement name="title-container" picking-mode="Ignore" class="titleContainer" style="margin-top: 6px; margin-left: 6px;">
        <ui:Label text="ENTRY" name="title" picking-mode="Ignore" class="title"/>
    </ui:VisualElement>
    <ui:VisualElement name="container" picking-mode="Ignore" class="container">
        <ui:VisualElement name="outport-container" picking-mode="Ignore" class="outportContainer" style="flex-grow: 0;"/>
    </ui:VisualElement>
</ui:UXML>
