/* The graph canvas reads as recessed under the inspector: a dark divider marks the seam and a faint
   highlight catches the inspector's edge. The canvas edge shadows live in PanelEdgeShadowElement.uss. */
#splitview .unity-two-pane-split-view__dragline-anchor {
    background-color: rgb(22, 22, 22);
}

#main-panel-right {
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.07);
}
