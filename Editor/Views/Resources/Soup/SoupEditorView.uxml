<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="SoupEditorView.uss"/>
    <ui:VisualElement name="base" style="display: flex; flex-grow: 1;">
        <ui:TwoPaneSplitView orientation="Horizontal" name="splitview" fixed-pane-index="1" fixed-pane-initial-dimension="400">
            <ui:VisualElement name="main-panel-left" style="min-width: auto; min-height: auto;"/>
            <ui:VisualElement name="main-panel-right"/>
        </ui:TwoPaneSplitView>
    </ui:VisualElement>
</ui:UXML>
