.group {
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.35);
}

.groupSelected {
    border-color: rgba(68, 192, 255, 1);
}

.groupTitle {
    min-height: 28px; /* Keep in sync with GroupView.TITLE_HEIGHT. */
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgba(0, 0, 0, 0.2);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

.groupTitleLabel {
    flex-shrink: 1;
    white-space: normal;
    color: rgba(215, 215, 215, 1);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.groupResizeHandle {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 14px;
    height: 14px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    border-bottom-right-radius: 4px;
    cursor: resize-up-left;
}