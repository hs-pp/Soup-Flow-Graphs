<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="PortView.uss"/>
    <ui:VisualElement picking-mode="Ignore" name="root" class="port" style="flex-grow: 1;">
        <ui:Label name="connector-label" picking-mode="Ignore" class="portLabel"/>
        <ui:VisualElement name="connector-box" picking-mode="Ignore" class="portConnectorBox">
            <ui:VisualElement name="connector-cap" picking-mode="Ignore" class="portConnectorCap"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
